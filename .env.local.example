# ============================================================
# Taurus Vision — Lokal sozlash (.env.local namunasi)
# ============================================================
#
# FOYDALANISH:
#   Bu faylni frontend/ papkasiga nusxalang:
#
#     cp .env.local.example frontend/.env.local
#
#   .env.local — git da SAQLANMAYDI (gitignore orqali)
#   .env.development faylidagi qiymatlarni ixtiyoriy OVERRIDE qiladi.
#
# QACHON KERAK:
#   Faqat Docker TASHQARIDA (npm run dev) ishlatganda:
#
#     cd frontend && npm run dev
#
#   Docker ichida ishlatganda (.env.local kerak emas — docker-compose
#   environment da BACKEND_URL "http://backend:8000" allaqachon o'rnatilgan).
#
# ============================================================

# Vite proksi uchun backend manzili.
# npm run dev (Docker siz): http://localhost:8000
# Docker ichida: http://backend:8000 (docker-compose.yml da avtomatik o'rnatiladi)
BACKEND_URL=http://localhost:8000

# VITE_API_URL va VITE_WS_URL ni BO'SH qoldiring — Vite proksi ishlaydi.
# (Bu qatorlarni o'zgartirish shart emas)
VITE_API_URL=
VITE_WS_URL=
