# ============================================================================
# Taurus Vision - Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to git (it's in .gitignore)
# ============================================================================

# ============================================================================
# APPLICATION
# ============================================================================
APP_NAME=Taurus Vision API
APP_VERSION=0.1.0
DEBUG=true

# ============================================================================
# SERVER
# ============================================================================
HOST=0.0.0.0
PORT=8000

# ============================================================================
# DATABASE
# ============================================================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://taurus:taurus123@localhost:5432/taurus_vision

# For production (async driver):
# DATABASE_URL=postgresql+asyncpg://taurus:taurus123@localhost:5432/taurus_vision

# For development (SQLite):
# DATABASE_URL=sqlite:///./taurus_vision.db

# ============================================================================
# CORS (Cross-Origin Resource Sharing)
# ============================================================================
# Comma-separated list of allowed origins
# For development: http://localhost:3000,http://localhost:5173
# For production: https://yourdomain.com
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ============================================================================
# LOGGING
# ============================================================================
LOG_DIR=./data/logs
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_ROTATION=true
LOG_RETENTION_DAYS=30

# ============================================================================
# FILE STORAGE
# ============================================================================
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes

# ============================================================================
# AI/ML MODELS
# ============================================================================
ML_MODEL_PATH=./ml/models
YOLO_MODEL=yolo11n.pt

# Model device (cpu, cuda, mps)
# Leave empty for auto-detection
MODEL_DEVICE=

# ============================================================================
# CAMERA SETTINGS
# ============================================================================
# Real camera RTSP URL (when available)
# CAMERA_URL=rtsp://username:password@192.168.1.100:554/stream

# Camera resolution
CAMERA_WIDTH=1920
CAMERA_HEIGHT=1080

# Camera FPS
CAMERA_FPS=10

# Frame skip (process every Nth frame)
FRAME_SKIP=5

# ============================================================================
# DETECTION SETTINGS
# ============================================================================
# Detection confidence threshold (0.0 - 1.0)
DETECTION_CONFIDENCE=0.5

# Weight estimation confidence threshold
WEIGHT_CONFIDENCE=0.5

# ============================================================================
# REDIS (Optional - for future use)
# ============================================================================
# REDIS_URL=redis://localhost:6379/0

# ============================================================================
# CELERY (Optional - for future use)
# ============================================================================
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ============================================================================
# SECURITY (Production)
# ============================================================================
# Secret key for JWT tokens (generate with: openssl rand -hex 32)
# SECRET_KEY=your-secret-key-here-change-in-production

# API rate limiting
# RATE_LIMIT_PER_MINUTE=60

# ============================================================================
# MONITORING (Production)
# ============================================================================
# SENTRY_DSN=https://your-sentry-dsn-here
# PROMETHEUS_PORT=9090

# ============================================================================
# DEVELOPMENT ONLY
# ============================================================================
# Enable API docs (Swagger UI)
ENABLE_DOCS=true

# Enable debug toolbar
ENABLE_DEBUG_TOOLBAR=false

# Auto-reload on code changes
AUTO_RELOAD=true
